{
  "name": "promptrc",
  "description": "A terminal for the prompts that worked — capture the prompts, phrasings, sequences, and benchmarks worth keeping.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 8080",
    "build": "vite build",
    "cf-typegen": "pnpm build && wrangler types worker-configuration.d.ts --config .output/server/wrangler.json",
    "preview": "vite preview",
    "deploy": "wrangler --cwd .output deploy",
    "deploy:dry-run": "wrangler --cwd .output deploy --dry-run",
    "db:migrate": "wrangler d1 migrations apply promptrc --local",
    "test": "vitest run --coverage",
    "typecheck": "pnpm cf-typegen && tsc --noEmit && tsc --project tests/tsconfig.json --noEmit",
    "lint": "oxlint --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm deploy:dry-run"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@clerk/tanstack-react-start": "^1.7.11",
    "@clerk/ui": "^1.42.4",
    "@fontsource-variable/recursive": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.5",
    "@tanstack/router-plugin": "^1.169.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.70.0",
    "nitro": "3.0.260610-beta",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-istanbul": "^5.1.0",
    "jsdom": "^31.0.0",
    "miniflare": "^4.20260730.0",
    "oxc-transform-react": "^0.157.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "shadcn": "^4.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "packageManager": "pnpm@12.18.0"
}
